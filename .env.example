# Copy this file to `.env` (same folder, project root) and fill in your
# own Supabase project's values. Never commit the real `.env` file.
#
# Both are FOUND in: Supabase Dashboard → Project Settings → API
#
# SUPABASE_URL is your project's REST/Auth URL.
# SUPABASE_ANON_KEY is the public "anon" / "publishable" key — it is safe
# to ship inside a mobile app because every table it can touch is locked
# down with Row Level Security. NEVER put the service_role key here.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
